{
  "name": "@ci/agent",
  "version": "0.2.1",
  "private": true,
  "description": "Comment Intelligence local agent",
  "author": "Marketing Team",
  "main": "./dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "test": "vitest run",
    "electron:dev": "node build.mjs && electron dist-electron/main.cjs",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "playwright": "^1.49.1",
    "playwright-core": "^1.49.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ci/scraper-core": "*",
    "@ci/shared": "*",
    "@types/ws": "^8.5.12",
    "electron": "31.7.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "type": "module"
}

# Comment Intelligence works with zero required environment variables.
# These are optional overrides.

# Port the local agent listens on (must match on web + agent)
CI_AGENT_PORT=8765

# Web app default URL used by docs/deployment only (no runtime secret)
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8765

# NOTA: NO existe modo "usar mi perfil personal de Chrome".
# Desde Chrome 136 (2025) Google bloquea el puerto de depuración sobre el
# perfil por defecto por seguridad anti-robo-de-sesiones. El login se hace
# UNA vez dentro del navegador dedicado del agente y queda persistente.
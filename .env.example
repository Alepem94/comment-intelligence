# Comment Intelligence works with zero required environment variables.
# These are optional overrides.

# Port the local agent listens on (must match on web + agent)
CI_AGENT_PORT=8765

# Web app default URL used by docs/deployment only (no runtime secret)
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:8765

# Modo perfil personal: usa tu Chrome de siempre (debes cerrar tus ventanas de Chrome
# antes de que el agente lo abra). Deja vacio para usar perfiles dedicados.
# CI_USE_PERSONAL_CHROME=1
